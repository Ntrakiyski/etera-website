# Public origin used for sitemap and robots metadata routes.
# Replace with the confirmed production origin when it is available.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use local Wrangler bindings for offline production-build verification.
PAYLOAD_CLOUDFLARE_LOCAL=1
PAYLOAD_SECRET=replace-with-a-secure-random-secret

# Server-only values: use .dev.vars locally and Wrangler secrets in production.
# Never prefix API/secret keys with NEXT_PUBLIC_.
RESEND_API_KEY=replace-with-resend-sending-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
